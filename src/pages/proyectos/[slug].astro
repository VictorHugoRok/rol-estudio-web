---
import { Image, getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Titular from '../../components/Titular.astro';
import { getProyectos } from '../../lib/proyectos';

// Genera una página por cada proyecto de src/content/proyectos/
export async function getStaticPaths() {
  const proyectos = await getProyectos();
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }));
}

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const { data } = proyecto;
const { Content } = await render(proyecto);

// Versión grande de cada imagen de la galería: es la que se abre al ampliarla.
// Nunca se agranda más allá del tamaño original.
const ANCHO_AMPLIADA = 1600;
const galeria = await Promise.all(
  data.galeria.map(async (item) => {
    const ancho = Math.min(item.imagen.width, ANCHO_AMPLIADA);
    const ampliada = await getImage({ src: item.imagen, width: ancho });
    return {
      ...item,
      ampliada: {
        src: ampliada.src,
        ancho,
        alto: Math.round((ancho * item.imagen.height) / item.imagen.width),
      },
    };
  }),
);
---

<Base titulo={data.nombre} descripcion={data.resumen} imagen={data.portada}>
  <article>
    <header class="page-shell detail-hero">
      <div class="detail-copy">
        <a class="text-link text-link-back" href="/proyectos/">Todos los proyectos</a>
        <p class="eyebrow">{data.tipo}</p>
        <h1>{data.nombre}</h1>
        <p class="detail-tagline"><Titular texto={data.titular} /></p>

        <div class="access" aria-labelledby="acceso-titulo">
          <h2 id="acceso-titulo" class="visually-hidden">Acceso</h2>
          {
            data.enlaces.length > 0 ? (
              <div class="access-buttons">
                {data.enlaces.map((enlace, i) => (
                  <a
                    class:list={['button', i === 0 ? 'button-primary' : 'button-sun']}
                    href={enlace.url}
                    target="_blank"
                    rel="noopener"
                  >
                    {enlace.texto}
                  </a>
                ))}
              </div>
            ) : (
              <p class="access-soon">
                <span class="tag">{data.estado}</span>
                <span>
                  Todavía no está disponible.{' '}
                  <a class="inline-link" href="/#contacto">
                    Escríbenos
                  </a>{' '}
                  y te avisamos cuando lo esté.
                </span>
              </p>
            )
          }
        </div>
      </div>

      <div class="detail-visual">
        <div class:list={['detail-frame', { completa: data.portadaCompleta }]}>
          <Image src={data.portada} alt={data.portadaAlt} width={720} loading="eager" />
        </div>
      </div>
    </header>

    <section class="page-shell detail-body">
      <div class="prose">
        <Content />
      </div>

      {
        data.caracteristicas.length > 0 && (
          <ul class="feature-list" aria-label={`Características de ${data.nombre}`}>
            {data.caracteristicas.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        )
      }
    </section>

    {
      galeria.length > 0 && (
        <section class="page-shell gallery-section" aria-labelledby="galeria-titulo">
          <h2 id="galeria-titulo">Galería</h2>
          <ul class:list={['gallery', { completa: data.galeriaCompleta }]}>
            {galeria.map((item) => (
              <li style={`--proporcion: ${item.imagen.width / item.imagen.height}`}>
                {/* Sin JavaScript, el enlace abre la imagen grande en la misma pestaña. */}
                <a
                  class="gallery-zoom"
                  href={item.ampliada.src}
                  aria-label={`Ampliar imagen: ${item.alt}`}
                  data-ancho={item.ampliada.ancho}
                  data-alto={item.ampliada.alto}
                >
                  <Image src={item.imagen} alt={item.alt} width={480} />
                </a>
              </li>
            ))}
          </ul>

          <dialog class="lightbox" aria-label="Imagen ampliada">
            <button class="button button-sun lightbox-close" type="button">Cerrar</button>
            <img class="lightbox-image" alt="" />
          </dialog>
        </section>
      )
    }
  </article>
</Base>

<style>
  .detail-hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(40px, 7vw, 100px);
    padding: 50px 0 90px;
  }

  .text-link-back {
    margin-bottom: 26px;
  }

  h1 {
    margin-bottom: 14px;
  }

  .detail-tagline {
    max-width: 520px;
    margin-bottom: 34px;
    color: var(--lilac);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.15;
  }

  .access-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .access-soon {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 18px;
    max-width: 520px;
    margin: 0;
    font-weight: 700;
  }

  .inline-link {
    color: var(--lilac);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .detail-frame {
    overflow: hidden;
    border: 3px solid var(--night);
    border-radius: 24px;
    box-shadow: 12px 12px 0 var(--leaf);
    transform: rotate(2deg);
  }

  .detail-frame img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .detail-frame.completa {
    background: var(--white);
  }

  .detail-frame.completa img {
    padding: 12%;
    object-fit: contain;
  }

  .detail-body {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: start;
    gap: clamp(40px, 7vw, 100px);
    padding: 40px 0 90px;
  }

  .prose {
    max-width: 640px;
    font-size: 1.12rem;
  }

  .prose :global(p) {
    margin-bottom: 1.1em;
  }

  .prose :global(a) {
    color: var(--lilac);
    font-weight: 800;
    text-decoration: underline;
  }

  .detail-body .feature-list {
    grid-template-columns: 1fr;
    margin: 0;
  }

  .gallery-section {
    padding-bottom: 130px;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery li {
    overflow: hidden;
    border: 2px solid var(--night);
    border-radius: 18px;
    background: var(--white);
    box-shadow: 6px 6px 0 var(--night);
  }

  .gallery li:nth-child(3n + 2) {
    box-shadow: 6px 6px 0 var(--lilac);
  }

  .gallery li:nth-child(3n + 3) {
    box-shadow: 6px 6px 0 var(--leaf);
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .gallery-zoom {
    display: block;
    cursor: zoom-in;
  }

  /* El <li> recorta lo que sobresale, así que el foco se dibuja en él. */
  .gallery li:has(.gallery-zoom:focus-visible) {
    outline: 3px solid var(--lilac);
    outline-offset: 3px;
  }

  /* Vista ampliada: ocupa toda la pantalla y se cierra con un clic o con Escape. */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: color-mix(in srgb, var(--night) 92%, transparent);
    cursor: zoom-out;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: lightbox-in 180ms ease;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  /* Lo más grande que quepa en la pantalla, sin deformarse ni pasar de su
     tamaño real. El hueco queda reservado antes de que cargue la imagen. */
  .lightbox-image {
    box-sizing: content-box;
    width: min(var(--ancho), 100vw - 38px, (100dvh - 38px) * var(--proporcion));
    aspect-ratio: var(--proporcion);
    border: 3px solid var(--cream);
    border-radius: 18px;
    background: var(--white);
  }

  .lightbox-close {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 1;
    cursor: pointer;
    font-family: inherit;
    font-size: 1rem;
    color: var(--night);
  }

  /* Lila sobre noche casi no se ve: aquí el foco va en sol. */
  .lightbox-close:focus-visible {
    outline-color: var(--sun);
  }

  /* Mientras la vista ampliada está abierta, la página de fondo no se desplaza. */
  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }

  /* Galería completa: filas justificadas. Cada imagen conserva su proporción
     y las de una misma fila quedan del mismo alto. Con 180px de alto base
     caben tres capturas horizontales por fila en escritorio y dos en tableta. */
  .gallery.completa {
    display: flex;
    flex-wrap: wrap;
  }

  .gallery.completa li {
    /* El borde no cuenta en el cálculo, así cuadran las alturas exactas. */
    box-sizing: content-box;
    flex: var(--proporcion) 1 calc(var(--proporcion) * 180px);
  }

  /* Relleno invisible: la última fila no se estira a todo lo ancho. */
  .gallery.completa::after {
    content: '';
    flex-grow: 1000;
  }

  .gallery.completa img {
    aspect-ratio: auto;
  }

  @media (max-width: 820px) {
    .detail-hero,
    .detail-body {
      grid-template-columns: 1fr;
    }

    .detail-visual {
      width: min(500px, 92%);
      margin-inline: auto;
    }
  }

  @media (max-width: 540px) {
    .detail-hero {
      padding: 30px 0 70px;
    }

    .gallery-section {
      padding-bottom: 90px;
    }
  }
</style>

<script>
  // Al hacer clic en una imagen de la galería se abre ampliada, entera y sin
  // recortes. <dialog> ya se encarga de Escape, de atrapar el foco y de
  // devolverlo a la miniatura al cerrar.
  const dialogo = document.querySelector<HTMLDialogElement>('.lightbox');
  const ampliada = dialogo?.querySelector<HTMLImageElement>('.lightbox-image');

  if (dialogo && ampliada) {
    document.querySelectorAll<HTMLAnchorElement>('.gallery-zoom').forEach((enlace) => {
      enlace.addEventListener('click', (evento) => {
        // Con Ctrl, Cmd o Shift se respeta "abrir en otra pestaña o ventana".
        if (evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) return;
        evento.preventDefault();

        const ancho = Number(enlace.dataset.ancho);
        const alto = Number(enlace.dataset.alto);
        ampliada.style.setProperty('--ancho', `${ancho}px`);
        ampliada.style.setProperty('--proporcion', String(ancho / alto));
        ampliada.alt = enlace.querySelector('img')?.alt ?? '';
        ampliada.src = enlace.href;
        dialogo.showModal();
      });
    });

    // Un clic en cualquier parte (fondo, imagen o botón) cierra la vista.
    dialogo.addEventListener('click', () => dialogo.close());

    // Se vacía para que la próxima vez no asome la imagen anterior.
    dialogo.addEventListener('close', () => ampliada.removeAttribute('src'));
  }
</script>
