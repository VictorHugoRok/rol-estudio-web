---
// Proyecto en formato grande (imagen + texto). Se usa en la página de inicio.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  /** Pone la imagen a la derecha (para alternar cuando hay varios proyectos). */
  invertido?: boolean;
  /** Texto pequeño sobre el título. */
  antetitulo?: string;
}

const { proyecto, invertido = false, antetitulo } = Astro.props;
const { data, id } = proyecto;
const urlDetalle = `/proyectos/${id}/`;
const accesoPrincipal = data.enlaces[0];
---

<article class:list={['project-grid', { invertido }]}>
  <div class="project-visual">
    <a class="project-frame" href={urlDetalle} tabindex="-1" aria-hidden="true">
      <Image src={data.portada} alt="" width={640} />
    </a>
    <span class="tag project-tag">{data.estado}</span>
  </div>

  <div class="project-copy">
    <p class="eyebrow">{antetitulo ?? data.tipo}</p>
    <h2>
      <a href={urlDetalle}>{data.titular}</a>
    </h2>
    <p class="project-summary">{data.resumen}</p>

    {
      data.caracteristicas.length > 0 && (
        <ul class="feature-list" aria-label={`Características de ${data.nombre}`}>
          {data.caracteristicas.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      )
    }

    <div class="project-actions">
      {
        accesoPrincipal && (
          <a class="button button-primary" href={accesoPrincipal.url} target="_blank" rel="noopener">
            {accesoPrincipal.texto}
          </a>
        )
      }
      <a class="text-link" href={urlDetalle}>Conoce {data.nombre}</a>
    </div>
  </div>
</article>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: minmax(310px, 0.9fr) 1.1fr;
    align-items: center;
    gap: clamp(50px, 8vw, 110px);
  }

  .project-grid.invertido .project-visual {
    order: 2;
  }

  .project-visual {
    position: relative;
  }

  .project-frame {
    display: block;
    overflow: hidden;
    border: 3px solid var(--night);
    border-radius: 24px;
    box-shadow: 12px 12px 0 var(--leaf);
    transform: rotate(-2deg);
  }

  .invertido .project-frame {
    box-shadow: 12px 12px 0 var(--lilac);
    transform: rotate(2deg);
  }

  .project-frame img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .project-frame:hover img {
    transform: scale(1.04);
  }

  .project-tag {
    position: absolute;
    top: -24px;
    right: -24px;
    transform: rotate(5deg);
  }

  .project-copy h2 a:hover {
    color: var(--lilac);
  }

  .project-summary {
    max-width: 570px;
    margin-bottom: 30px;
    font-size: 1.08rem;
  }

  .project-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
  }

  @media (max-width: 820px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 65px;
    }

    .project-grid.invertido .project-visual {
      order: 0;
    }

    .project-visual {
      width: min(500px, 92%);
      margin-inline: auto;
    }
  }

  @media (max-width: 540px) {
    .project-tag {
      right: -8px;
    }
  }
</style>
