---
import { Image } from 'astro:assets';
import manga from '../assets/malix/malix_icono_manga.png';
import pintura from '../assets/malix/malix_icono_pintura.png';
import pixelart from '../assets/malix/malix_icono_pixelart.png';
import silueta from '../assets/malix/malix_icono_silueta.png';
import silueta2 from '../assets/malix/malix_icono_silueta2.png';

// Malix va cambiando de estilo cada 3 segundos 
const iconos = [
  { src: pintura },
  { src: manga },
  { src: silueta },
  // Mide 64 px: se escala en CSS sin suavizado y se deja en PNG para que
  // los píxeles queden nítidos.
  { src: pixelart, pixelado: true },
  { src: silueta2 },
];
---

<section class="page-shell hero" id="inicio">
  <div class="hero-copy">
    <h1>Creemos en seguir<span>aprendiendo.</span></h1>
    <p class="hero-lead">
      Porque creo significa crear y creer, y para crear hay que creer.

— IDOR

    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="/proyectos/">Descubre nuestros proyectos</a>
      <a class="text-link" href="/#estudio">Conócenos</a>
    </div>
  </div>

  <div class="hero-art">
    <span class="spark spark-one" aria-hidden="true">✦</span>
    <span class="spark spark-two" aria-hidden="true">✷</span>
    <div class="blob" aria-hidden="true"></div>
    <div
      class="malix"
      role="img"
      aria-label="Malix, la mascota de Rol Estudio: un perrito enroscado y dormido."
    >
      {
        iconos.map(({ src, pixelado }, i) => (
          <Image
            src={src}
            alt=""
            width={pixelado ? undefined : 420}
            format={pixelado ? 'png' : undefined}
            class:list={[{ 'is-active': i === 0, 'is-pixelado': pixelado }]}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        ))
      }
    </div>
    <p class="art-note">¡Hola! Soy Malix, tu guía por aquí.</p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 50px;
    min-height: calc(100vh - 88px);
    min-height: calc(100svh - 88px);
    padding: 64px 0 100px;
  }

  h1 {
    max-width: 690px;
  }

  h1 span {
    position: relative;
    z-index: 0;
    display: inline-block;
    color: var(--lilac);
    white-space: nowrap;
  }

  h1 span::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: 3%;
    right: -2%;
    bottom: 0.08em;
    height: 0.18em;
    border-radius: 20px;
    background: var(--sun);
    transform: rotate(-1.5deg);
  }

  .hero-lead {
    max-width: 570px;
    margin-bottom: 34px;
    color: var(--night-76);
    font-size: 1.1rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
  }

  .hero-art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 530px;
  }

  .blob {
    position: absolute;
    width: min(440px, 90%);
    aspect-ratio: 1;
    border: 3px solid var(--night);
    border-radius: 46% 54% 63% 37% / 42% 35% 65% 58%;
    background: var(--sun);
    box-shadow: 14px 14px 0 var(--lilac);
    transform: rotate(-4deg);
  }

  /* Los dibujos se apilan en la misma celda y solo el activo es visible. */
  .malix {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(420px, 86%);
    filter: drop-shadow(0 18px 12px var(--night-18));
    animation: float 4s ease-in-out infinite;
  }

  .malix img {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .malix img.is-active {
    opacity: 1;
  }

  .malix img.is-pixelado {
    image-rendering: pixelated;
  }

  .art-note {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 72px;
    max-width: 200px;
    margin: 0;
    padding: 12px 18px;
    border: 2px solid var(--night);
    border-radius: var(--radius);
    background: var(--cream);
    box-shadow: 5px 5px 0 var(--night);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.15;
    transform: rotate(3deg);
  }

  .spark {
    position: absolute;
    color: var(--leaf);
    font-size: 3rem;
    font-weight: 900;
  }

  .spark-one {
    top: 55px;
    left: 3%;
    transform: rotate(18deg);
  }

  .spark-two {
    top: 125px;
    right: 2%;
    color: var(--lilac);
    font-size: 2rem;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(1deg);
    }
    50% {
      transform: translateY(-13px) rotate(-1deg);
    }
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 10px;
      min-height: auto;
      padding-top: 55px;
      text-align: center;
    }

    h1,
    .hero-lead {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-art {
      min-height: 460px;
    }
  }

  @media (max-width: 540px) {
    .hero {
      padding-bottom: 75px;
    }

    h1 {
      font-size: clamp(3rem, 15vw, 4.4rem);
    }

    .hero-art {
      min-height: 380px;
    }

    .art-note {
      right: 5px;
      bottom: 35px;
    }
  }
</style>

<script>
  // Cambia el dibujo de Malix cada 3 segundos, en bucle. Si la persona
  // prefiere menos movimiento, Malix se queda quieto.
  const INTERVALO = 3000;
  const iconos = document.querySelectorAll<HTMLImageElement>('.malix img');
  const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

  let actual = 0;
  let temporizador: number | undefined;

  const avanzar = () => {
    for (let paso = 1; paso < iconos.length; paso++) {
      const siguiente = (actual + paso) % iconos.length;
      const icono = iconos[siguiente];
      // Si aún no termina de cargar, se espera al próximo turno.
      if (!icono.complete) return;
      // Si no se pudo cargar (404, sin red), se salta para no mostrar una imagen rota.
      if (icono.naturalWidth === 0) continue;
      iconos[actual].classList.remove('is-active');
      icono.classList.add('is-active');
      actual = siguiente;
      return;
    }
  };

  // Solo rota con la pestaña visible y sin preferencia de menos movimiento.
  const actualizar = () => {
    window.clearInterval(temporizador);
    temporizador = undefined;
    if (!menosMovimiento.matches && !document.hidden) {
      temporizador = window.setInterval(avanzar, INTERVALO);
    }
  };

  if (iconos.length > 1) {
    actualizar();
    menosMovimiento.addEventListener('change', actualizar);
    document.addEventListener('visibilitychange', actualizar);
  }
</script>
