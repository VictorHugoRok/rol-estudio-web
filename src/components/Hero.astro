---
import { Image } from 'astro:assets';
import icono from '../assets/malix/icono.png';
---

<section class="page-shell hero" id="inicio">
  <div class="hero-copy">
    <p class="eyebrow">Un pequeño estudio indie</p>
    <h1>Creamos mundos para <span>perderse.</span></h1>
    <p class="hero-lead">
      Somos Rol Estudio. Diseñamos apps gamificadas y juegos con identidad, personajes
      inolvidables y esas historias que se quedan contigo mucho después de apagar la pantalla.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="/proyectos/">Descubre nuestros proyectos</a>
      <a class="text-link" href="/#estudio">Conócenos</a>
    </div>
  </div>

  <div class="hero-art">
    <span class="spark spark-one" aria-hidden="true">✦</span>
    <span class="spark spark-two" aria-hidden="true">✷</span>
    <div class="blob" aria-hidden="true"></div>
    <Image
      src={icono}
      alt="Malix, la mascota de Rol Estudio: un perrito dibujado a mano, enroscado y dormido."
      width={420}
      loading="eager"
      fetchpriority="high"
    />
    <p class="art-note">¡Hola! Soy Malix, tu guía por aquí.</p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 50px;
    min-height: calc(100vh - 88px);
    min-height: calc(100svh - 88px);
    padding: 64px 0 100px;
  }

  h1 {
    max-width: 690px;
  }

  h1 span {
    position: relative;
    z-index: 0;
    display: inline-block;
    color: var(--lilac);
    white-space: nowrap;
  }

  h1 span::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: 3%;
    right: -2%;
    bottom: 0.08em;
    height: 0.18em;
    border-radius: 20px;
    background: var(--sun);
    transform: rotate(-1.5deg);
  }

  .hero-lead {
    max-width: 570px;
    margin-bottom: 34px;
    color: var(--night-76);
    font-size: 1.1rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
  }

  .hero-art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 530px;
  }

  .blob {
    position: absolute;
    width: min(440px, 90%);
    aspect-ratio: 1;
    border: 3px solid var(--night);
    border-radius: 46% 54% 63% 37% / 42% 35% 65% 58%;
    background: var(--sun);
    box-shadow: 14px 14px 0 var(--lilac);
    transform: rotate(-4deg);
  }

  .hero-art img {
    position: relative;
    z-index: 2;
    width: min(420px, 86%);
    filter: drop-shadow(0 18px 12px var(--night-18));
    animation: float 4s ease-in-out infinite;
  }

  .art-note {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 72px;
    max-width: 200px;
    margin: 0;
    padding: 12px 18px;
    border: 2px solid var(--night);
    border-radius: var(--radius);
    background: var(--cream);
    box-shadow: 5px 5px 0 var(--night);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.15;
    transform: rotate(3deg);
  }

  .spark {
    position: absolute;
    color: var(--leaf);
    font-size: 3rem;
    font-weight: 900;
  }

  .spark-one {
    top: 55px;
    left: 3%;
    transform: rotate(18deg);
  }

  .spark-two {
    top: 125px;
    right: 2%;
    color: var(--lilac);
    font-size: 2rem;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(1deg);
    }
    50% {
      transform: translateY(-13px) rotate(-1deg);
    }
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 10px;
      min-height: auto;
      padding-top: 55px;
      text-align: center;
    }

    h1,
    .hero-lead {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-art {
      min-height: 460px;
    }
  }

  @media (max-width: 540px) {
    .hero {
      padding-bottom: 75px;
    }

    h1 {
      font-size: clamp(3rem, 15vw, 4.4rem);
    }

    .hero-art {
      min-height: 380px;
    }

    .art-note {
      right: 5px;
      bottom: 35px;
    }
  }
</style>
