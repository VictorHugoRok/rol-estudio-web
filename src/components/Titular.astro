---
// Titular de un proyecto. Lo que va entre dobles asteriscos (**así**) se
// resalta como una pepita de oro que brilla, para juegos de palabras como
// «No todo lo que br**IA** es oro».
interface Props {
  texto: string;
}

const { texto } = Astro.props;

// Cada resaltado se lleva las letras pegadas a él («br» + «IA»), así la
// palabra completa nunca se parte en dos renglones.
type Trozo = string | { antes: string; resaltado: string; despues: string };

const trozos: Trozo[] = [];
let ultimo = 0;
for (const coincidencia of texto.matchAll(/(\S*)\*\*(.+?)\*\*(\S*)/g)) {
  const [completa, antes, resaltado, despues] = coincidencia;
  trozos.push(texto.slice(ultimo, coincidencia.index));
  trozos.push({ antes, resaltado, despues });
  ultimo = coincidencia.index + completa.length;
}
trozos.push(texto.slice(ultimo));

// Destello de cuatro puntas, como los de los dibujos de joyas.
const destello = 'M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z';
---

{
  trozos.map((trozo) =>
    typeof trozo === 'string' ? (
      trozo
    ) : (
      <span class="palabra">{trozo.antes}<strong class="oro">{trozo.resaltado}<svg class="destello destello-grande" viewBox="-3 -3 30 30" aria-hidden="true"><path d={destello} /></svg><svg class="destello destello-chico" viewBox="-3 -3 30 30" aria-hidden="true"><path d={destello} /></svg></strong>{trozo.despues}</span>
    ),
  )
}

<style>
  .palabra {
    white-space: nowrap;
  }

  /* Una placa dorada con el mismo trazo de los botones y las etiquetas. */
  .oro {
    position: relative;
    display: inline-block;
    margin-left: 0.06em;
    padding: 0.02em 0.14em 0;
    border: max(2px, 0.05em) solid var(--night);
    border-radius: 0.2em;
    background: linear-gradient(
        115deg,
        var(--sun) 42%,
        var(--white) 48% 52%,
        var(--sun) 58%
      )
      100% 0 / 250% 100% var(--sun);
    box-shadow: 0.07em 0.07em 0 var(--night);
    color: var(--night);
    font-weight: 400;
    line-height: 1;
    transform: rotate(-5deg);
  }

  .destello {
    position: absolute;
    fill: var(--sun);
    stroke: var(--night);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  .destello-grande {
    top: -0.42em;
    right: -0.38em;
    width: 0.5em;
  }

  .destello-chico {
    bottom: -0.2em;
    left: -0.3em;
    width: 0.3em;
  }

  /* Cada tanto, un reflejo blanco cruza la placa y los destellos guiñan. */
  @media (prefers-reduced-motion: no-preference) {
    .oro {
      animation: reflejo 4.5s ease-in-out infinite;
    }

    .destello {
      animation: guino 4.5s ease-in-out infinite;
    }

    .destello-chico {
      animation-delay: -0.6s;
    }
  }

  @keyframes reflejo {
    0%,
    55% {
      background-position: 100% 0;
    }

    85%,
    100% {
      background-position: 0 0;
    }
  }

  @keyframes guino {
    0%,
    66%,
    100% {
      transform: scale(1) rotate(0);
    }

    80% {
      transform: scale(1.4) rotate(25deg);
    }
  }
</style>
