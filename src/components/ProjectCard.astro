---
// Tarjeta compacta de proyecto. Se usa en /proyectos/.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { data, id } = Astro.props.proyecto;
---

<article class="card">
  <div class="card-media">
    <Image src={data.portada} alt="" width={560} />
    <span class="tag card-tag">{data.estado}</span>
  </div>
  <div class="card-body">
    <p class="card-type">{data.tipo}</p>
    <h3>
      <a class="card-link" href={`/proyectos/${id}/`}>{data.nombre}</a>
    </h3>
    <p>{data.resumen}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid var(--night);
    border-radius: 20px;
    background: var(--white);
    box-shadow: 6px 6px 0 var(--night);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .card:hover {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0 var(--night);
  }

  .card-media {
    position: relative;
    border-bottom: 2px solid var(--night);
  }

  .card-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .card-tag {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 6px 12px;
    box-shadow: 3px 3px 0 var(--night);
    font-size: 0.68rem;
  }

  .card-body {
    padding: 22px 24px 26px;
  }

  .card-type {
    margin-bottom: 6px;
    color: var(--leaf);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .card-body p:last-child {
    margin: 0;
    color: var(--night-76);
  }

  /* Toda la tarjeta es clicable, pero el enlace real es solo el título. */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:focus-within {
    outline: 3px solid var(--lilac);
    outline-offset: 4px;
  }

  .card-link:focus-visible {
    outline: none;
  }
</style>
